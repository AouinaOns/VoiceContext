# ─── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # Required for the voice agent (simple_agent.py)

# ─── STT ────────────────────────────────────────────────────────────────────
STT_PROVIDER=whisper-local          # whisper-local | deepgram | assemblyai | openai
STT_MODEL=whisper-large-v3
STT_API_KEY=                        # Required for cloud providers
STT_LANGUAGE=                       # Auto-detect if empty

# ─── Emotion ─────────────────────────────────────────────────────────────────
EMOTION_ENABLED=true
EMOTION_PROVIDER=speechbrain-local  # speechbrain-local | hume | deepgram
EMOTION_API_KEY=

# ─── Intent ──────────────────────────────────────────────────────────────────
INTENT_ENABLED=false
INTENT_DOMAIN=generic               # support | medical | ecommerce | hospitality | generic
OPENAI_API_KEY=                     # Used for LLM-based intent extraction

# ─── Diarization ─────────────────────────────────────────────────────────────
DIARIZATION=false

# ─── Memory ──────────────────────────────────────────────────────────────────
MEMORY_BACKEND=memory               # memory | redis
MEMORY_WINDOW=10
REDIS_URL=redis://localhost:6379

# ─── Server (HTTP transport) ─────────────────────────────────────────────────
PORT=3000
API_KEY=                            # Protect the HTTP MCP endpoint
