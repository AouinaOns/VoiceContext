FROM ghcr.io/astral-sh/uv:python3.11-alpine

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY apps/demo/pyproject.toml apps/demo/uv.lock ./
RUN uv sync --frozen --no-cache

COPY apps/demo/src/simple_agent.py .

CMD ["uv", "run", "python", "simple_agent.py", "--text"]
